  "mandatory_rules": [
    "Global discovery before local adaptation",
    "Narrative continuity over isolated viral posts",
    "Original POV over generic content",
    "Evidence-led content over unsupported advice",
    "No repeated headline formula across consecutive posts",
    "Natural Persian over translated or machine-like Persian",
    "Channel adaptation over copy-paste",
    "Canonical terminology over synonym drift",
    "Selective build in public over uncontrolled disclosure",
    "Published status only after verified live URL",
    "Influence to Opportunity to Revenue over vanity metrics",
    "Trend adoption only when it improves trust, distribution or discovery",
    "Pinned persian-writing baseline is mandatory for every Persian deliverable: register, naturalness, orthography and RTL must pass before publication or delivery"
  ],
  "review": {
    "strategy": "quarterly or on material positioning change",
    "content_season_01": "every 4 weeks and at season close",
    "production_queue": "weekly",
    "instagram_content_strategy_proposal": "after 20-30 reels or 90 days, whichever provides sufficient evidence",
    "language_core": "semiannual or on material voice change",
    "global_trend_radar": "weekly",
    "persian_trend_research": "monthly or quarterly",
    "publication_learning": "T+24h, T+72h, T+7d, T+30d when relevant",
    "trend_layer": "quarterly",
    "kpis": "monthly",
    "cover_system": "semiannual or when channel behavior materially changes"
  },
